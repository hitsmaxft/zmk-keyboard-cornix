 *
 * SPDX-License-Identifier: MIT
 *
 * Ported from a personal RMK (rmk-cornix) keyboard.toml configuration.
 * Replaces the original zmk-keyboard-cornix default keymap (which was the
 * repo author's own heavily-customized personal layout) with a direct
 * translation of that RMK config's 4 layers, encoders, and combos.
 */

#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define LOWER  1
#define UPPER  2
#define ADJUST 3

// RMK [behavior.morse]: hold_timeout = 250ms, hold_on_other_press = true.
&mt {
    flavor = "hold-preferred";
    tapping-term-ms = <250>;
};

/ {
    behaviors {
        // RMK's second encoder is bound to MouseWheelDown/MouseWheelUp on every
        // layer. ZMK has no built-in "&inc_dec_msc"-style wrapper for &msc, so it
        // needs its own zmk,behavior-sensor-rotate node (see e.g.
        // sayu-hub/zmk-config-moNa2 for this exact pattern).
        mwheel: behavior_sensor_rotate_mouse_wheel {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // RMK [behavior.combo]: timeout = 50ms.
        combo_leftbracket {
            timeout-ms = <50>;
            bindings = <&kp LBKT>;
            key-positions = <3 4>;   // E, R
        };

        combo_rightbracket {
            timeout-ms = <50>;
            bindings = <&kp RBKT>;
            key-positions = <4 5>;   // R, T
        };

        combo_lparen {
            timeout-ms = <50>;
            bindings = <&kp LPAR>;
            key-positions = <6 7>;   // Y, U
        };

        combo_rparen {
            timeout-ms = <50>;
            bindings = <&kp RPAR>;
            key-positions = <7 8>;   // U, I
        };

        combo_lbrace {
            timeout-ms = <50>;
            bindings = <&kp LBRC>;
            key-positions = <18 19>; // H, J
        };

        combo_rbrace {
            timeout-ms = <50>;
            bindings = <&kp RBRC>;
            key-positions = <19 20>; // J, K
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ---------------------------------------------------------------------------------------------------
            // | ESC   |  Q  |  W  |  E  |  R    |  T           |         | Y            |  U  |  I   |  O  |  P    | BSPC  |
            // | TAB   |  A  |  S  |  D  |  F    |  G           |         | H            |  J  |  K   |  L  |  ;    |  '    |
            // | SHIFT |  Z  |  X  |  C  |  V    |  B    | MUTE | MCLK    | N            |  M  |  ,   |  .  |  /    | GRAVE |
            // | CTRL  | GUI | ALT | GUI | MO(1) | MT(SPACE,CTRL)         | MT(ENT,SHFT) | MO(2) | RALT | LEFT | DOWN | RIGHT |

            bindings = <
&kp ESC    &kp Q    &kp W    &kp E    &kp R  &kp T                        &kp Y          &kp U     &kp I      &kp O    &kp P     &kp BSPC
&kp TAB    &kp A    &kp S    &kp D    &kp F  &kp G                        &kp H          &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z    &kp X    &kp C    &kp V  &kp B    &kp C_MUTE &mkp MCLK  &kp N          &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp GRAVE
&kp LCTRL  &kp LGUI &kp LALT &kp LGUI &mo LOWER  &mt LCTRL SPACE              &mt RSHFT RET  &mo UPPER     &kp RALT   &kp LEFT &kp DOWN  &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &mwheel>;
        };

        lower_layer {
            display-name = "Lower";

            // -----------------------------------------------------------------------------------------------------
            // | `   | 1   | 2   | 3   | 4   | 5           |            | 6      | 7    | 8    | 9    | 0    | trans |
            // |trans| ___ | BT0 | BT1 | BT2 | -           |            | LEFT   | DOWN | UP   | RIGHT| ___  | ___   |
            // |trans| ___ | ___ | ___ | ___ | ___  | MUTE | MCLK       | ___    | ___  | ___  | ___  | ___  | ___   |
            // | ___ | ___ | ___ | ___ | ___ | ___         | trans      | MO(3)  | trans| ___  | ___  | ___  |

            bindings = <
&kp GRAVE &kp N1 &kp N2      &kp N3      &kp N4      &kp N5                        &kp N6    &kp N7    &kp N8 &kp N9 &kp N0 &trans
&trans    &none  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &kp MINUS                    &kp LEFT  &kp DOWN  &kp UP &kp RIGHT &none &none
&trans    &none  &none       &none       &none       &none    &kp C_MUTE &mkp MCLK  &none     &none     &none  &none  &none  &none
&none     &none  &none       &none       &none       &none                          &trans    &mo ADJUST     &trans &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &mwheel>;
        };

        upper_layer {
            display-name = "Upper";

            // -------------------------------------------------------------------------------------------------------
            // |trans| !   | @   | #   | $   | %           |            | ^     | &    | *    | (    | )    | trans |
            // |trans| ___ | ___ | ___ | ___ | ___         |            | KP+   | KP-  | =    | ___  | ___  | |     |
            // |trans| ___ | ___ | ___ | ___ | ___  | MUTE | MCLK       | _     | KP/  | ___  | ___  | ___  | ___   |
            // |trans| ___ | ___ | ___ | ___ | SPACE       | ENTER      | ___   | ___  | ___  | ___  | ___  |

            bindings = <
&trans &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT                       &kp CARET &kp AMPS     &kp ASTRK &kp LPAR &kp RPAR &trans
&trans &none    &none    &none    &none    &none                          &kp KP_PLUS &kp KP_MINUS &kp EQUAL &none    &none    &kp PIPE
&trans &none    &none    &none    &none    &none    &kp C_MUTE &mkp MCLK  &kp UNDER &kp KP_SLASH &none     &none    &none    &none
&trans &none    &none    &none    &none    &kp SPACE                      &kp RET   &none        &none     &none    &none    &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &mwheel>;
        };

        adjust_layer {
            display-name = "Adjust";

            // -----------------------------------------------------------------------------------------
            // | ___ | ___   | ___    | ___ | ___ | ___         |            | ___ | ___ | ___ | ___ | ___ | ___ |
            // | BT0 | NXTBT | ___    | ___ | ___ | ___         |            | ___ | ___ | ___ | ___ | ___ | ___ |
            // | BT1 | CLRBT | ___    | ___ | ___ | ___  | MUTE | MCLK       | ___ | ___ | ___ | ___ | ___ | ___ |
            // | BT2 | ___   | ___    | ___ | ___ | ___         |            | ___ | ___ | ___ | ___ | ___ |

            bindings = <
&none        &none      &none &none &none &none                       &none &none &none &none &none &none
&bt BT_SEL 0 &bt BT_NXT &none &none &none &none                       &none &none &none &none &none &none
&bt BT_SEL 1 &bt BT_CLR &none &none &none &none    &kp C_MUTE &mkp MCLK  &none &none &none &none &none &none
&bt BT_SEL 2 &none      &none &none &none &none                       &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &mwheel>;
        };
    };
};
